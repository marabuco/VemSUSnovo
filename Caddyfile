# HTTPS automático (Let's Encrypt). Sem diretiva `log`: o Caddy não grava access log,
# o que evita registrar coordenadas que o app envia na query (?lat=..&lng=..).
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy app:8000
}
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
